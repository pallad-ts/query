{
  "name": "@pallad/query-graphql",
  "version": "8.0.3",
  "description": "GraphQL types for @pallad/query",
  "scripts": {
    "test": "yarn run -TB vitest run --passWithNoTests",
    "lint": "yarn run -TB eslint src/**/*.ts",
    "build:clean": "yarn run -TB tsc --build --clean tsconfig.build.json",
    "entrysmith": "yarn run generate-barrels && yarn run -TB entrysmith fix",
    "prepare": "yarn run entrysmith",
    "prepublish": "yarn run compile",
    "compile": "yarn run entrysmith && yarn run build:clean && yarn run -TB tsc --build tsconfig.build.json",
    "generate-barrels": "yarn run -TB barrelsby -l replace -L --delete -d ./src"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pallad-ts/query.git",
    "directory": "package/graphql"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "author": "Łukasz Kużyński <lukasz.kuzynski@gmail.com> (http://wookieb.pl/)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/pallad-ts/query/issues"
  },
  "homepage": "https://github.com/pallad-ts/query#readme",
  "peerDependencies": {
    "graphql": "^16"
  },
  "devDependencies": {
    "graphql": "^16.13.2"
  },
  "dependencies": {
    "@pallad/cursor-encoder": "^2",
    "@pallad/cursor-encoder-graphql": "^1.0.0",
    "@pallad/query-descriptor": "^6",
    "camel-case": "^4.1.2",
    "graphql-scalars": "^1.17.0",
    "predicates": "^2.0.3",
    "tslib": "^2.8.1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  }
}
